{
  "name": "reaa-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "npm run build:web && wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "db:init:local": "wrangler d1 execute AUTH_DB --local --file=./db/auth_schema.sql",
    "db:init:remote": "wrangler d1 execute AUTH_DB --remote --file=./db/auth_schema.sql"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "hono": "^4.7.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.166.0"
  }
}
